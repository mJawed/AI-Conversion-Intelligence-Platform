{
  "name": "@ai-growth/api",
  "private": true,
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:validate": "prisma validate --schema ../../prisma/schema.prisma",
    "db:format": "prisma format --schema ../../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma --name init",
    "db:migrate:auth": "prisma migrate dev --schema ../../prisma/schema.prisma --name auth",
    "db:migrate:tracking": "prisma migrate dev --schema ../../prisma/schema.prisma --name tracking",
    "db:migrate:security": "prisma migrate dev --schema ../../prisma/schema.prisma --name security",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:status": "prisma migrate status --schema ../../prisma/schema.prisma",
    "infra:check": "node ../../scripts/validate-production-env.mjs",
    "infra:check:services": "node ../../scripts/check-infrastructure.mjs",
    "clickhouse:schema": "node ../../scripts/apply-clickhouse-schema.mjs",
    "db:seed": "tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
