NODE_ENV=development
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCK_DATA=true
CORS_ORIGINS=http://localhost:3000
TRACKING_SCRIPT_URL=http://localhost:4000/tracker.js
JWT_SECRET=replace-with-a-long-random-secret
BILLING_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
DATABASE_URL=postgresql://growth:growth@localhost:5432/growth
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://growth:growth@localhost:5672
CLICKHOUSE_URL=http://localhost:8123
EVENT_PIPELINE_ENABLED=false
REDIS_ENABLED=false
CLICKHOUSE_ENABLED=false
ENCRYPTION_KEY=replace-with-64-hex-characters

# Free MVP mode keeps external queues and analytics services optional.
FREE_MVP_MODE=true
ANALYTICS_STORAGE=postgres
POSTGRES_EVENT_STORAGE_ENABLED=false
EVENT_RETENTION_DAYS=30
MAX_TRACKING_EVENTS_PER_DAY=100000

# Production uses a secrets manager; do not commit real values to this file.
